# HTTPS GitHub URL of the repo under test, no credentials embedded
GIT_REPO_URL=https://github.com/rosettadb/dbt-studio.git

# Read-only GitHub user/token used to authenticate the clone
GIT_USERNAME=x-access-token
GIT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Image built from docker/test-runner.Dockerfile (see scripts/build-test-image.sh)
TEST_RUNNER_IMAGE=e2e-test-runner:latest

PORT=4300
