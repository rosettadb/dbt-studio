# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed

# Coverage directory used by tools like istanbul
coverage
.eslintcache

# Dependency directory
# https://www.npmjs.org/doc/misc/npm-faq.html#should-i-check-my-node_modules-folder-into-git
node_modules

# OSX
.DS_Store

release/app/dist
release/build
.erb/dll

.idea
npm-debug.log.*
*.css.d.ts
*.sass.d.ts
*.scss.d.ts

# Stylesheets aren't JavaScript. ESLint skips them when it walks a directory,
# but tools that hand it the list of changed files instead will try to parse
# them as TS and fail on the first selector.
*.css
*.scss

# eslint ignores hidden directories by default:
# https://github.com/eslint/eslint/issues/8429
!.erb

# Vendor libraries
src/main/lib/GPUdb.js
