exports[`generateProfilesYml characterization bigquery (location and batch priority): full text 1`] = `
"proj:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: service-account
      project: '{{ env_var("db-project-bq_loc") }}'
      dataset: '{{ env_var("db-dataset-bq_loc") }}'
      threads: 4
      priority: batch
      keyfile: '{{ env_var("db-bigquery-bq_loc") }}'
      location: EU
"
`;

