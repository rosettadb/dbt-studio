exports[`generateProfilesYml characterization kinetica (host and port): full text 1`] = `
"proj:
  target: dev
  outputs:
    dev:
      type: kinetica
      host: '{{ env_var("db-url-kin_plain") }}'
      user: '{{ env_var("db-user-kin_plain") }}'
      password: '{{ env_var("db-password-kin_plain") }}'
      schema: '{{ env_var("db-schema-kin_plain") }}'
      threads: 4
      database: '{{ env_var("db-dbname-kin_plain") }}'
      disable_auto_discovery: true
"
`;

exports[`generateProfilesYml characterization kinetica (useSSL with bypassSslCertCheck): full text 1`] = `
"proj:
  target: dev
  outputs:
    dev:
      type: kinetica
      host: '{{ env_var("db-url-kin_ssl") }}'
      user: '{{ env_var("db-user-kin_ssl") }}'
      password: '{{ env_var("db-password-kin_ssl") }}'
      schema: '{{ env_var("db-schema-kin_ssl") }}'
      threads: 4
      database: '{{ env_var("db-dbname-kin_ssl") }}'
      disable_auto_discovery: true
      skip_ssl_cert_verification: true
"
`;

