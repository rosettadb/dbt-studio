// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`loadConfigurations characterization writes profiles.yml and main.conf for a dbt connection 1`] = `
{
  "mainConf": "openai_api_key: \${openai-api-key}
connections:
  - name: proj
    databaseName: \${db-dbname-pg_plain}
    schemaName: \${db-schema-pg_plain}
    dbType: postgres
    url: >-
      jdbc:postgresql://\${db-host-pg_plain}:\${db-port-pg_plain}/\${db-dbname-pg_plain}?currentSchema=\${db-schema-pg_plain}
    userName: \${db-user-pg_plain}
    password: \${db-password-pg_plain}
",
  "profiles": "proj:
  target: dev
  outputs:
    dev:
      type: postgres
      host: '{{ env_var("db-host-pg_plain") }}'
      port: '{{ env_var("db-port-pg_plain") | int }}'
      user: '{{ env_var("db-user-pg_plain") }}'
      password: '{{ env_var("db-password-pg_plain") }}'
      dbname: '{{ env_var("db-dbname-pg_plain") }}'
      schema: '{{ env_var("db-schema-pg_plain") }}'
      threads: 4
",
  "project": {
    "connectionId": "c1",
    "dbtConnection": {
      "database": "pgdb",
      "host": "pg.example.com",
      "password": "db-password-pg_plain",
      "port": 5432,
      "schema": "public",
      "type": "postgres",
      "username": "db-user-pg_plain",
    },
    "id": "p1",
    "name": "proj",
    "path": "<PROJECT_DIR>",
    "rosettaConnection": {
      "databaseName": "pgdb",
      "dbType": "postgres",
      "name": "proj",
      "password": "db-password-pg_plain",
      "schemaName": "public",
      "url": "jdbc:postgresql://\${db-host-pg_plain}:\${db-port-pg_plain}/\${db-dbname-pg_plain}?currentSchema=\${db-schema-pg_plain}",
      "userName": "db-user-pg_plain",
    },
  },
}
`;

