exports[`buildDialectHints characterization oracle 1`] = `
"

## Dialect Specifics
You are connected to Oracle Database. Use Oracle SQL. Do not add row limits to queries; the UI handles pagination with \`OFFSET ... FETCH NEXT\`. The dummy table is \`DUAL\`, unquoted identifiers fold to uppercase, table aliases cannot use \`AS\`, catalog metadata lives in \`ALL_*\` views (\`ALL_TABLES\`, \`ALL_USERS\`, \`ALL_TAB_COLUMNS\`), and statements must not end with \`;\`."
`;

